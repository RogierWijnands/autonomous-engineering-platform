{
  "name": "jira-simulator-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "nodemon --exitcrash --signal SIGTERM --watch src --ext ts,json --exec node src/index.ts",
    "build": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.json\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3"
  }
}
