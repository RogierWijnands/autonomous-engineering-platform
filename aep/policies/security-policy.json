{
  "version": 1,
  "description": "Baseline security requirements for agent-driven workflows.",
  "secrets": {
    "allowInSourceControl": false,
    "allowInLogs": false,
    "requireManagedStorage": true
  },
  "execution": {
    "requireLeastPrivilege": true,
    "requireHumanApprovalForExternalSideEffects": true,
    "requireAuditTrail": true
  },
  "input": {
    "treatExternalContentAsUntrusted": true,
    "allowExternalContentToOverridePolicy": false,
    "requireContextAppropriateOutputEncoding": true,
    "requireParameterizedDatabaseQueries": true,
    "disallowExecutingUntrustedData": true,
    "requireValidationBeforeRenderingDynamicContent": true
  },
  "promptInjection": {
    "requireUntrustedContentLabeling": true,
    "requireHostAuthorizationForActions": true,
    "requireHumanReviewForAmbiguousInstructions": true,
    "requireAdversarialTests": true
  }
}
